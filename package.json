{
  "name": "zqxconsulting-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next dev",
    "build": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next build",
    "start": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next build && next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.8.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "overrides": {
    "postcss": "8.5.28",
    "source-map-js": "1.2.2"
  }
}
